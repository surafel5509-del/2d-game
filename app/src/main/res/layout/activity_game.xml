<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060E">

    <com.nebula.engine.EngineView
        android:id="@+id/engineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sandbox banner -->
    <TextView
        android:id="@+id/tvSandboxBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:text="@string/sandbox_banner"
        android:textColor="@color/nebula_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:visibility="gone" />

    <!-- Steering hint (auto-hides) -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="@string/hud_hint"
        android:textColor="@color/nebula_text"
        android:textSize="12sp" />

    <!-- Score chip -->
    <LinearLayout
        android:id="@+id/panelScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="10dp" android:paddingBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_score"
            android:textColor="@color/nebula_text_dim"
            android:textSize="10sp"
            android:letterSpacing="0.2" />
        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/nebula_accent"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <!-- Lives + back chip -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:gravity="end">
        <LinearLayout
            android:id="@+id/panelLives"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_lives"
                android:textColor="@color/nebula_text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.2" />
            <TextView
                android:id="@+id/tvLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤❤❤"
                android:textColor="@color/nebula_danger"
                android:textSize="22sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ghost_circle"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/content_back"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Game over overlay -->
    <LinearLayout
        android:id="@+id/panelGameOver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC05060E"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_over_title"
            android:textColor="@color/nebula_danger"
            android:textSize="44sp"
            android:textStyle="bold"
            android:letterSpacing="0.28" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/game_over_subtitle"
            android:textColor="@color/nebula_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFinalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SCORE 0"
            android:textColor="@color/nebula_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tvBestScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="BEST 0"
            android:textColor="@color/nebula_amber"
            android:textSize="14sp"
            android:letterSpacing="0.18" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="@string/retry"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.22"
            app:backgroundTint="@color/nebula_accent"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainMenu"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/main_menu"
            android:textSize="13sp"
            android:letterSpacing="0.18"
            style="@style/Widget.AppCompat.Button.Borderless"
            app:strokeColor="@color/nebula_stroke"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/nebula_panel_2"
            app:cornerRadius="14dp" />
    </LinearLayout>
</FrameLayout>
